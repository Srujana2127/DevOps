
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out Python project'
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('Question-4-Metrics-Exporter') {
                    echo 'Installing Python dependencies'
                    sh 'python3 -m venv venv'
                    sh 'venv/bin/pip install -r requirements.txt'
                }
            }
        }

        stage('Build') {
            steps {
                dir('Question-4-Metrics-Exporter') {
                    echo 'Building Metrics Exporter'
                    sh 'python3 -m py_compile app.py'
                    sh 'mkdir -p deployment'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Question-4-Metrics-Exporter') {
                    echo 'Running automated tests'
                    sh 'venv/bin/pytest -v'
                }
            }
        }

        stage('Package Deployment') {
            steps {
                dir('Question-4-Metrics-Exporter') {
                    echo 'Packaging deployment files'
                    sh '''
                        mkdir -p deployment
                        cp app.py requirements.txt test_app.py deployment/
                        tar -czf metrics-exporter.tar.gz deployment
                    '''
                    archiveArtifacts artifacts: 'metrics-exporter.tar.gz'
                }
            }
        }
    }

    post {
        success {
            echo 'Metrics Exporter Pipeline completed successfully!'
        }
        failure {
            echo 'Metrics Exporter Pipeline FAILED. Check stage logs.'
        }
        always {
            echo 'Pipeline execution finished.'
        }
    }
}
