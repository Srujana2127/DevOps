
{
  "uid": "quick-commerce",
  "title": "Quick Commerce Real-Time Monitoring",
  "tags": ["quick-commerce", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Deliveries",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {
          "expr": "quickcommerce_deliveries_total",
          "legendFormat": "Completed Deliveries",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total Orders",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {
          "expr": "quickcommerce_orders_total",
          "legendFormat": "Orders",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Delivery Duration (95th Percentile)",
      "type": "timeseries",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(quickcommerce_delivery_duration_seconds_bucket[2m])) by (le))",
          "legendFormat": "95th percentile",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Deliveries Per Second",
      "type": "timeseries",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 17},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {
          "expr": "rate(quickcommerce_deliveries_total[1m])",
          "legendFormat": "Deliveries/sec",
          "refId": "A"
        }
      ]
    }
  ]
}
