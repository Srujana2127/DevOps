#include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected) {
    #include <abstractions/base>

    # Allow Python to run the Flask application
    /usr/local/bin/python* rix,
    /usr/local/lib/python3.8/** mr,
    /usr/local/lib/python3.8/** r,

    # Application files
    /app/ r,
    /app/** rw,

    # Required shared libraries and runtime files
    /lib/** mr,
    /usr/lib/** mr,
    /etc/ld.so.cache r,
    /etc/localtime r,
    /etc/hosts r,
    /etc/resolv.conf r,

    # Allow network access for the Flask server
    network inet stream,
    network inet6 stream,

    # Allow binding to the application port
    capability net_bind_service,

    # Deny access to sensitive files
    deny /etc/shadow r,
    deny /root/** rwklx,
    deny /var/** rwklx,

    # Deny execution of shell binaries
    deny /bin/bash x,
    deny /usr/bin/bash x,
}
